NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: enable real PTV / Transport Victoria data in a future iteration (not required for the MVP).
PTV_DEV_ID=
PTV_API_KEY=
TRANSPORT_VIC_API_KEY=
